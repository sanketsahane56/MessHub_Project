<script>
// Set default start date to today
document.addEventListener('DOMContentLoaded', function() {
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('startDateInput').value = today;
    document.getElementById('startDateInput').min = today;
});

function selectPlan(planName, price, timeOption, cardId) {
    // Highlight selected card
    document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('active-plan'));
    const selectedCard = document.getElementById(cardId);
    if (selectedCard) selectedCard.classList.add('active-plan');

    // Update Dropdown
    const select = document.getElementById('planSelect');
    for (let i = 0; i < select.options.length; i++) {
        if (select.options[i].value === planName) {
            select.selectedIndex = i;
            break;
        }
    }

    // Update Price input & summary
    document.getElementById('planPriceInput').value = price;
    updateSummary();

    // Smooth scroll down to booking form
    document.getElementById('booking-form-section').scrollIntoView({ behavior: 'smooth' });
}

function onPlanChange() {
    const select = document.getElementById('planSelect');
    const selectedOption = select.options[select.selectedIndex];
    const price = selectedOption.getAttribute('data-price') || 3500;
    const time = selectedOption.getAttribute('data-time') || 'दोन्ही वेळ';
    
    document.getElementById('planPriceInput').value = price;
    updateSummary();
}

function updateSummary() {
    // Branch
    const branches = document.getElementsByName('branch_location');
    let selectedBranch = 'Gangapur Gaon, Nashik';
    for (let b of branches) {
        if (b.checked) {
            selectedBranch = b.value;
            break;
        }
    }
    document.getElementById('summary-branch').innerText = selectedBranch.includes('Nashik') ? 'गंगापूर गाव, नाशिक' : 'पिंपळगाव निपाणी, अकोले';

    // Plan
    const select = document.getElementById('planSelect');
    const selectedPlanName = select.value;
    document.getElementById('summary-plan').innerText = selectedPlanName;

    // Price
    const price = document.getElementById('planPriceInput').value;
    document.getElementById('summary-total').innerText = '₹' + Number(price).toLocaleString('en-IN');

    // Time
    const timeSelect = document.getElementById('tiffinTimeSelect');
    document.getElementById('summary-time').innerText = timeSelect.value.split('(')[0];
}
</script>

